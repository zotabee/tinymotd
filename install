#!/usr/bin/env bash

usage() {
    echo "usage: ./${0##*/} --user <USER> [--uninstall]"
}

# verify permission
if [[ "${EUID}" != 0 ]]; then
    echo 'Error: permission denied' >&2
    echo 'installation requires root privileges' >&2
    exit 1
fi

# go to script dir
dir=$(readlink -f "${0}"); cd "${dir%/*}"

# add cron scheduled job
add_cron() {
    local name="${1}"
    local cmd="${2}"
    local motd="${3}"
    local cron_file="/etc/cron.hourly/${name}"
    echo "[+] add cron in ${cron_file}"
    cat << EOF > "${cron_file}"
#!/usr/bin/env sh
"${cmd}" > "${motd}"
EOF
    chmod +x "${cron_file}"
}

# add systemd scheduled job
add_systemd() {
    local name="${1}"
    local cmd="${2}"
    local motd="${3}"
    local service_file="/etc/systemd/system/${name}.service"
    echo "[+] add service in ${service_file}"
    cat << EOF > "${service_file}"
[Unit]
Description=${name} executor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${cmd}
StandardOutput=truncate:${motd}
EOF
    local timer_file="/etc/systemd/system/${name}.timer"
    echo "[+] add timer in ${timer_file}"
    cat << EOF > "${timer_file}"
[Unit]
Description=${name} timer

[Timer]
OnCalendar=hourly
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload
    systemctl enable --now "${name}.timer"
}

# remove scheduled jobs and motd print
uninstall() {
    local name="${1}"
    local bashrc="${2}"
    if [[ -f "/etc/systemd/system/${name}.timer" ]]; then
        echo "[-] remove service and timer in /etc/systemd/system"
        systemctl disable --now "${name}.timer"
        rm -f "/etc/systemd/system/${name}".{service,timer}
        systemctl daemon-reload
    fi
    if [[ -f "/etc/cron.hourly/${name}" ]]; then
        echo "[-] remove cron in /etc/cron.hourly/${name}"
        rm -f "/etc/cron.hourly/${name}"
    fi
    if grep -qsx '# motd supervision' "${bashrc}"; then
        echo "[-] remove motd load in ${bashrc}"
        sed -i '/^# motd supervision$/,/^fi$/d' "${bashrc}"
    fi
}

# parse args
while (( ${#} )); do
    case "${1}" in
        -u|--user)      shift; user="${1}";;
        --uninstall)    uninstall=1;;
        *)              echo "Error: unknown option ${1}" >&2; exit 1;;
    esac
    shift
done

if [[ -z "${user}" ]]; then
    echo 'Error: no user specified' >&2
    usage >&2
    exit 1
fi

# get homedir
IFS=: read -r _ _ _ _ _ home _ < <(getent passwd "${user}")
if [[ -z "${home}" ]]; then
    echo "Error: unknown user '${user}'" >&2
    exit 1
fi

if [[ -n "${uninstall}" ]]; then
    uninstall 'tinymotd' "${home}/.bashrc"
    exit 0
fi

# create data dir
mkdir -p data

# search for job scheduler
motd="${PWD}/data/motd"
if [[ -d /run/systemd/system ]]; then
    add_systemd 'tinymotd' "${PWD}/generate" "${motd}"
elif [[ -d /etc/cron.hourly ]]; then
    add_cron 'tinymotd' "${PWD}/generate" "${motd}"
else
    echo 'Error: no job scheduler method found' >&2
    exit 1
fi

# add print
bashrc="${home}/.bashrc"
if grep -qsF "${motd}" "${bashrc}"; then
    echo "[=] motd load already in ${bashrc}"
else
    echo "[+] add motd load in ${bashrc}"
    cat << EOF >> "${bashrc}"
# motd supervision
if [[ -r '${motd}' ]]; then
    cat '${motd}'
fi
EOF
fi
