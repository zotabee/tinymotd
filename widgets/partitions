#!/usr/bin/env bash

# partitions usage:
#   30%  /
#   50%  /backup
#   25%  /data

columns=1
disk_warn=80 # %
filter='docker/overlay' # excluded target separated by |

#width=7
#bar() {
#    ((elapsed=$1*$2/100))
#    printf -v prog  "%${elapsed}s"
#    printf -v total "%$(($2-elapsed))s"
#    #printf '%s\n' "[${prog// /o}${total}]"
#    printf '%s\n' "[${prog// /o}${total}]"
#}

source ../tools/colors.sh
mapfile -t dfs < <(df -hT | tail -n +2 | grep -vE "tmpfs|vfat|efivarfs|${filter}" | sort -k7)

out=''
for i in "${!dfs[@]}"; do
    read -r _ _ _ _ _ pcent target <<< "${dfs[${i}]}"
    pcentnb="${pcent%\%}"
    pcent=$(c_if "${pcentnb}" '<' "${disk_warn}" '%')
    out+="${pcent}|${target}|"
    #out+="$(bar ${pcentnb} ${width})|${pcent}|${target}|"
    (( (i+1) % columns == 0 )) && out+='\n'
done

echo
echo 'partitions usage:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
