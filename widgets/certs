#!/usr/bin/env bash
# /!\ Need openssl binary

# certificates:
#   o debian.org  01/01/2035
#   x github.com  01/01/2020

# domains list
domains=('debian.org' 'github.com')

printf -v date '%(%Y%m%d)T' -1
data='../data/certs'

certdate() {
    timeout 5 openssl s_client -servername "${1}" -connect "${1}:443" </dev/null 2>/dev/null \
     | openssl x509 -noout -enddate 2>/dev/null
}

source ../tools/colors.sh
[[ -r "${data}" ]] && source "${data}"
if [[ "${lastupdate}" != "${date}" ]]; then
    failed=''
    declare -A stamps=()
    for d in "${domains[@]}"; do
        c_raw=$(certdate "${d}")
        if [[ -n "${c_raw}" ]]; then
            stamps[${d}]=$(date -d "${c_raw#*=}" +%s)
        else
            failed=1
        fi
    done
    # cache only if all domains answered, retry next run otherwise
    if [[ -z "${failed}" ]]; then
        lastupdate=${date}
        declare -p lastupdate stamps > "${data}"
    fi
fi

printf -v now '%(%s)T' -1
out=''
for d in "${domains[@]}"; do
    stamp="${stamps[${d}]}"
    if [[ -z "${stamp}" ]]; then
        out+="${bred}!${reset} ${d}|unreachable\n"
        continue
    fi
    state=$(c_if_r "${stamp}" '>=' "${now}" 'o' 'x')
    printf -v c_date '%(%d/%m/%Y)T' "${stamp}"
    out+="${state} ${d}|${c_date}\n"
done

echo
echo 'certificates:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
