#!/usr/bin/env bash
# /!\ Need pacman packages manager and fakeroot binary

# packages:
#   4 upgradable  3 cleanable
#   0 foreign

printf -v date '%(%Y%m%d)T' -1
data='../data/pacman'
columns=2

source ../tools/colors.sh
[[ -r "${data}" ]] && source "${data}"

# One query per line: '<name>  <pacman option>'
# Comment a line to disable
packages_query=(
  'upgradable  -Qu'
  'cleanable   -Qdt'
  'foreign     -Qm'
)

if [[ "${lastupdate}" != "${date}" ]]; then
    db="${PWD%/*}/data/.pacman-db"
    mkdir -p "${db}"
    dbpath=$(pacman-conf DBPath)
    ln -s "${dbpath}/local" "${db}" &>/dev/null
    # on sync failure, keep lastupdate to retry next run
    fakeroot -- pacman -Sy --dbpath "${db}" --logfile /dev/null &>/dev/null && lastupdate="${date}"
    declare -A pkgs
    for entry in "${packages_query[@]}"; do
        label="${entry%% *}"
        query="${entry##* }"
        pkgs[${label}]=$(pacman "${query}" --dbpath "${db}" 2>/dev/null | wc -l)
    done
    declare -p lastupdate pkgs > "${data}"
fi

out=''
for i in "${!packages_query[@]}"; do
    label="${packages_query[${i}]%% *}"
    value=$(c_if "${pkgs[${label}]}" '<' '1')
    out+="${value} ${label}|"
    (( (i+1) % columns == 0 )) && out+='\n'
done
if [[ -z "${out}" ]]; then
    out='none'
fi

echo
echo 'packages:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
