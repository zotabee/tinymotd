#!/usr/bin/env bash
# /!\ Need docker binary

# containers:
#   o alpine  x nginx
#   o blog    x git

columns=2
filter='_nothing_'  # excluded containers separated by |

source ../tools/colors.sh
mapfile -t containers < <(docker ps -a --format '{{.Names}} {{.State}}' | grep -Ev "^(${filter})")

out=''
for i in "${!containers[@]}"; do
    read -r name state <<< "${containers[${i}]}"
    state=$(c_match_r "${state}" 'running' 'o' 'x')
    out+="${state} ${name}|"
    (( (i+1) % columns == 0 )) && out+='\n'
done
if [[ -z "${out}" ]]; then
    out='none'
fi

echo
echo 'containers:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
