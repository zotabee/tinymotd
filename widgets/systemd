#!/usr/bin/env bash
# /!\ Need systemctl binary

# systemd:
#   x systemd-networkd  x nftables
#   x apparmor

columns=2

source ../tools/colors.sh

out=''
state=$(systemctl is-system-running)
if [[ "${state}" == 'running' ]]; then
    out="${bgreen}o${reset} operational"
else
    mapfile -t failed_services < <(systemctl list-units --failed --plain --no-legend)
    for i in "${!failed_services[@]}"; do
        unit="${failed_services[${i}]%% *}"
        out+="${bred}x${reset} ${unit%.*}|"
        (( (i+1) % columns == 0 )) && out+='\n'
    done
    # no failed unit: show state (starting, maintenance, ...)
    if [[ -z "${out}" ]]; then
        out="${bred}x${reset} ${state}"
    fi
fi

echo
echo 'systemd:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
