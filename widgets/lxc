#!/usr/bin/env bash
# /!\ Need lxc binaries

# containers:
#   o git   o mailer  o dlna
#   x plex

columns=2
filter='_nothing_'  # excluded containers separated by |

source ../tools/colors.sh
mapfile -t -s 1 containers < <(lxc-ls -f | grep -Ev "^(${filter})|^$")

out=''
for i in "${!containers[@]}"; do
    read -r name state _ <<< "${containers[${i}]}"
    state=$(c_match_r "${state}" 'RUNNING' 'o' 'x')
    out+="${state} ${name}|"
    (( (i+1) % columns == 0 )) && out+='\n'
done
if [[ -z "${out}" ]]; then
    out='none'
fi

echo
echo 'containers:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
