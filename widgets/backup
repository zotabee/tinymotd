#!/usr/bin/env bash

# backup:
#   o os (5d)  x cloud (45d)

columns=2
age_warn=35 # day(s)

# One backup per line: '<name>  <status file>'
# status file must contain: YYYYMMDD;success or YYYYMMDD;failed
backups=(
  "os     /backup/os/status"
  "cloud  /backup/cloud/status"
)

source ../tools/colors.sh

printf -v now '%(%s)T' -1
out=''
for i in "${!backups[@]}"; do
    bkp_name="${backups[${i}]%% *}"
    bkp_file="${backups[${i}]##* }"
    if [[ ! -f "${bkp_file}" ]]; then
        age='-'
        bkp_status="${bred}!${reset}"
    else
        IFS=';' read -r bkp_date bkp_status < <(tail -n1 "${bkp_file}")
        diff=$(( (now - $(date -d "${bkp_date}" +%s)) / 86400 ))
        age="${diff}d"
        if [[ "${bkp_status}" == 'success' ]]; then
            bkp_status=$(c_if_r "${diff}" '<' "${age_warn}" 'o' 'x')
        else
            bkp_status="${bred}x${reset}"
        fi
    fi
    out+="${bkp_status} ${bkp_name} (${age})|"
    (( (i+1) % columns == 0 )) && out+='\n'
done

echo
echo 'backup:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
