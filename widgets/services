#!/usr/bin/env bash
# /!\ Need systemctl binary

# services:
#   x lxc  o firewall  o ssh

columns=3

# One service per line: '<name>  <unit>'
# Comment a line to disable
services=(
  'lxc       lxc'
  'firewall  nftables'
  'ssh       sshd'
)

source ../tools/colors.sh
mapfile -t svc_states < <(systemctl is-active "${services[@]##* }")

out=''
for i in "${!services[@]}"; do
    svc_status=$(c_match_r "${svc_states[${i}]}" 'active' 'o' 'x')
    out+="${svc_status} ${services[${i}]%% *}|"
    (( (i+1) % columns == 0 )) && out+='\n'
done

echo
echo 'services:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
