#!/usr/bin/env bash

# go to script dir
dir=$(readlink -f "${0}"); cd "${dir%/*}"

# create data dir
mkdir -p data
# remove old data
shopt -s extglob
if [[ ${1} == '-f' ]]; then
    rm -f data/!(motd)
fi

# print header
cat headers/* 2>/dev/null

# get widgets results
cd widgets
# execute widgets in columns
while read -ra row; do
    [[ ${row[0]} == \#* ]] && continue
    for i in "${!row[@]}"; do
        # append content
        [[ -f ${row[${i}]} ]] && f[${i}]+="${f[${i}]:+\n}$(./"${row[${i}]}" 2>/dev/null)"
    done
done < ../config

# print
motd=''
for c in "${f[@]}"; do
    [[ -z ${motd} ]] && motd="${c}" || motd=$(paste <(echo -e "${motd}") <(echo -e "${c}"))
done
echo -e "${motd}" | column -Lts $'\t'

# print messages
cd ..
cat messages/* 2>/dev/null
echo
